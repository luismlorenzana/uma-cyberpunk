# Production build config (CY3). Firebase web values are PUBLIC client config, safe to ship in the bundle: the API's
# Firebase-token guard and the owner allowlist are the real security. This is the "Uma Cyberpunk web" app in project
# uma-rpg (one login for every app, IN3), created by CY2's bootstrap. The auth domain is the Hosting domain, so the auth
# handler is same-origin inside the iOS Home Screen app (as uma-rpg does).
VITE_FIREBASE_AUTH_DOMAIN=uma-cyberpunk.web.app
VITE_FIREBASE_PROJECT_ID=uma-rpg
VITE_FIREBASE_APP_ID=1:727687479415:web:783eab238dc074ff684672
VITE_FIREBASE_API_KEY=AIzaSyCysnRIbFgh4ILYIgwjs_rSgyoCnxYbJ2g
